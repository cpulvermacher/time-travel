{
    "name": "time-travel",
    "version": "2.5.1",
    "license": "MIT",
    "private": "true",
    "scripts": {
        "build": "sh ./util/build.sh production",
        "dev": "sh ./util/build.sh dev",
        "lint": "tsc && biome check *.mts *.ts src/ e2e/ && svelte-check --tsconfig ./tsconfig.json && pnpm lint:translations",
        "lint:translations": "bash ./util/check-translations.sh",
        "fix": "biome check --write *.mts *.ts src/ e2e/",
        "format": "biome format --write *.mts *.ts src/ e2e/",
        "test": "vitest --run",
        "test:e2e": "playwright test",
        "screenshots": "SCREENSHOTS=1 playwright test screenshots --project=chromium",
        "coverage": "vitest --run --coverage",
        "checkall": "pnpm test && pnpm lint && pnpm build",
        "machine-translate": "inlang machine translate --project project.inlang"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.6",
        "@inlang/cli": "^3.2.0",
        "@inlang/paraglide-js": "^2.23.0",
        "@playwright/test": "^1.62.0",
        "@sveltejs/vite-plugin-svelte": "^7.2.0",
        "@tsconfig/svelte": "^5.0.8",
        "@types/chrome": "^0.2.2",
        "@vitest/coverage-v8": "^4.1.10",
        "chrome-webstore-upload-cli": "^3.5.0",
        "globals": "^17.7.0",
        "happy-dom": "^20.11.1",
        "svelte-check": "^4.7.4",
        "typescript": "^6.0.3",
        "vite": "^8.1.5",
        "vitest": "^4.1.10",
        "web-ext": "^10.5.0"
    },
    "dependencies": {
        "@svelte-plugins/datepicker": "^1.0.11",
        "svelte": "^5.56.8"
    },
    "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
