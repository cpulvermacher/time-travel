{
    "extends": "@tsconfig/svelte/tsconfig.json",
    "compilerOptions": {
        "target": "ES2023",
        "useDefineForClassFields": true,
        "lib": ["DOM", "DOM.Iterable", "ES2023", "ESNext.Temporal", "ESNext.Date"],
        "allowJs": true,
        "skipLibCheck": true,
        "incremental": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": false,
        "noEmit": true,
        "paths": {
            "@/*": ["./src/*"]
        },
        "types": ["chrome"]
    },
    "include": ["src/", "e2e/", "*.mts", "*.ts"]
}
